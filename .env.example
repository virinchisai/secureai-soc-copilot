# Copy this file to .env before running locally.
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# MVP demo account. Replace these values before sharing the app.
DEMO_USERNAME=analyst
DEMO_PASSWORD=change-me

# OpenAI embeddings are used for FAISS with either chat provider.
OPENAI_API_KEY=sk-your-key
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Choose "openai" or "anthropic" for answer generation.
LLM_PROVIDER=openai
OPENAI_CHAT_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=sk-ant-your-key
ANTHROPIC_CHAT_MODEL=claude-haiku-4-5
LLM_MAX_TOKENS=1000
LLM_TIMEOUT_SECONDS=60

DATA_DIR=./data
MAX_UPLOAD_MB=10
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
RETRIEVAL_K=4

# Used by the Streamlit container or local frontend process.
API_BASE_URL=http://localhost:8000
