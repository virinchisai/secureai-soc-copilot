# Copy this file to .env before running locally.
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# MVP demo account. Replace these values before sharing the app.
DEMO_USERNAME=analyst
DEMO_PASSWORD=change-me

# Free local mode uses Ollama for embeddings and answer generation.
EMBEDDING_PROVIDER=ollama
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_CHAT_MODEL=deepseek-r1:1.5b

# Optional paid provider settings.
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_CHAT_MODEL=claude-haiku-4-5
LLM_MAX_TOKENS=120
LLM_TIMEOUT_SECONDS=180

DATA_DIR=./data
MAX_UPLOAD_MB=10
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
RETRIEVAL_K=2
MODEL_CONTEXT_CHARS_PER_SOURCE=500

# Used by the Streamlit container or local frontend process.
API_BASE_URL=http://localhost:8000
REQUEST_TIMEOUT_SECONDS=210
